{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@domainstack/typescript-config/nextjs.json",
  "compilerOptions": {
    "types": ["vitest/globals", "vitest/browser"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
