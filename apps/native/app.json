{
  "expo": {
    "name": "Domainstack",
    "slug": "domainstack",
    "scheme": "domainstack",
    "version": "0.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "io.domainstack.app",
      "appleTeamId": "B5ZWKBCUTU",
      "icon": "./assets/AppIcon.icon",
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "io.domainstack.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#FFFFFF"
      },
      "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY}"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/with-google-sign-in-url-scheme.cjs",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": false
        }
      ],
      "expo-status-bar",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "${EXPO_PUBLIC_DOMAINSTACK_API_URL}",
      "googleIosClientId": "${EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID}",
      "googleWebClientId": "${EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID}",
      "posthogKey": "${EXPO_PUBLIC_POSTHOG_KEY}",
      "posthogHost": "${EXPO_PUBLIC_POSTHOG_HOST}",
      "router": {},
      "eas": {
        "projectId": "ff044af0-bf08-40bb-919f-04c950d11b14"
      }
    },
    "owner": "jakejarvis"
  }
}
