{
  "expo": {
    "name": "Domainstack",
    "slug": "domainstack",
    "scheme": "domainstack",
    "version": "0.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "io.domainstack.app",
      "entitlements": {
        "com.apple.security.application-groups": ["group.io.domainstack.app"]
      },
      "appleTeamId": "B5ZWKBCUTU",
      "icon": "./assets/AppIcon.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "package": "io.domainstack.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#FFFFFF"
      },
      "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY}"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "mode": "production",
          "icon": "./assets/adaptive-icon-mono.png",
          "color": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": false
        }
      ],
      "expo-status-bar",
      "expo-localization",
      [
        "expo-share-intent",
        {
          "iosAppGroupIdentifier": "group.io.domainstack.app",
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": ["text/*"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "${EXPO_PUBLIC_DOMAINSTACK_API_URL}",
      "googleIosClientId": "${EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID}",
      "googleWebClientId": "${EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID}",
      "posthogKey": "${EXPO_PUBLIC_POSTHOG_KEY}",
      "posthogHost": "${EXPO_PUBLIC_POSTHOG_HOST}",
      "router": {},
      "eas": {
        "projectId": "ff044af0-bf08-40bb-919f-04c950d11b14"
      }
    },
    "owner": "jakejarvis"
  }
}
