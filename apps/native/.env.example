# Local Expo auth environment.
EXPO_PUBLIC_DOMAINSTACK_API_URL=http://localhost:3000

# Google native sign-in uses the web client ID for Android ID tokens.
# iOS native sign-in also needs the iOS client ID; without it, iOS falls back to browser OAuth.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Maps SDK for Android (hosting section map view).
# Required for Android builds only — iOS uses Apple Maps without an API key.
# Create at https://console.cloud.google.com → enable "Maps SDK for Android",
# restrict by package name (io.domainstack.app) + SHA-1 fingerprint.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
