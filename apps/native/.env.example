# Local Expo auth environment.
# Keep provider flags in sync with the public OAuth flags used by apps/web.
EXPO_PUBLIC_DOMAINSTACK_API_URL=http://localhost:3000

# Set a provider to "true" only when the local web app has matching Better Auth
# OAuth credentials configured.
EXPO_PUBLIC_APPLE_OAUTH_ENABLED=false
EXPO_PUBLIC_GITHUB_OAUTH_ENABLED=false
EXPO_PUBLIC_GITLAB_OAUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_OAUTH_ENABLED=false
EXPO_PUBLIC_VERCEL_OAUTH_ENABLED=false

# Google native sign-in uses the SDK only when both IDs are present. Without an
# iOS client ID, the native app still renders Google and falls back to browser OAuth.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
