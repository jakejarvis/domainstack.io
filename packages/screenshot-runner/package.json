{
  "name": "@domainstack/screenshot-runner",
  "version": "0.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:blocklist": "node dist/build-blocklist.js",
