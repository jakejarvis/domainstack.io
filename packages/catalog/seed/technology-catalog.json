[
  {
    "slug": "wordpress",
    "name": "WordPress",
    "categories": ["cms"],
    "website": "https://wordpress.org",
    "implies": ["php"],
    "rule": {
      "any": [
        {
          "kind": "metaRegex",
          "name": "generator",
          "pattern": "^WordPress(?:\\s+([\\d.]+))?",
          "version": 1
        },
        { "kind": "htmlRegex", "pattern": "/wp-(?:content|includes)/" }
      ]
    }
  },
  {
    "slug": "drupal",
    "name": "Drupal",
    "categories": ["cms"],
    "website": "https://www.drupal.org",
    "implies": ["php"],
    "rule": {
      "any": [
        {
          "kind": "metaRegex",
          "name": "generator",
          "pattern": "^Drupal\\s+([\\d.]+)",
          "version": 1
        },
        {
          "kind": "headerRegex",
          "name": "x-generator",
          "pattern": "^Drupal\\s+([\\d.]+)",
          "version": 1
        },
        { "kind": "metaRegex", "name": "generator", "pattern": "^Drupal" }
      ]
    }
  },
  {
    "slug": "joomla",
    "name": "Joomla",
    "categories": ["cms"],
    "website": "https://www.joomla.org",
    "implies": ["php"],
    "rule": {
      "kind": "metaRegex",
      "name": "generator",
      "pattern": "^Joomla!(?:\\s+([\\d.]+))?",
      "version": 1
    }
  },
  {
    "slug": "ghost",
    "name": "Ghost",
    "categories": ["cms"],
    "website": "https://ghost.org",
    "rule": {
      "kind": "metaRegex",
      "name": "generator",
      "pattern": "^Ghost(?:\\s+([\\d.]+))?",
      "version": 1
    }
  },
  {
    "slug": "squarespace",
    "name": "Squarespace",
    "categories": ["cms", "hosting"],
    "website": "https://www.squarespace.com",
    "rule": {
      "any": [
        { "kind": "headerRegex", "name": "server", "pattern": "^Squarespace" },
        { "kind": "htmlRegex", "pattern": "static1\\.squarespace\\.com" }
      ]
    }
  },
  {
    "slug": "wix",
    "name": "Wix",
    "categories": ["cms", "hosting"],
    "website": "https://www.wix.com",
    "rule": {
      "any": [
        { "kind": "headerPresent", "name": "x-wix-request-id" },
        { "kind": "metaRegex", "name": "generator", "pattern": "^Wix\\.com" }
      ]
    }
  },
  {
    "slug": "webflow",
    "name": "Webflow",
    "categories": ["cms", "hosting"],
    "website": "https://webflow.com",
    "rule": { "kind": "metaRegex", "name": "generator", "pattern": "^Webflow" }
  },
  {
    "slug": "shopify",
    "name": "Shopify",
    "categories": ["ecommerce", "hosting"],
    "website": "https://www.shopify.com",
    "rule": {
      "any": [
        { "kind": "headerPresent", "name": "x-shopid" },
        { "kind": "headerPresent", "name": "x-shopify-stage" },
        { "kind": "htmlRegex", "pattern": "cdn\\.shopify\\.com" }
      ]
    }
  },
  {
    "slug": "woocommerce",
    "name": "WooCommerce",
    "categories": ["ecommerce"],
    "website": "https://woocommerce.com",
    "implies": ["wordpress"],
    "rule": {
      "any": [
        {
          "kind": "metaRegex",
          "name": "generator",
          "pattern": "^WooCommerce\\s+([\\d.]+)",
          "version": 1
        },
        { "kind": "htmlRegex", "pattern": "/plugins/woocommerce/" }
      ]
    }
  },
  {
    "slug": "nextjs",
    "name": "Next.js",
    "categories": ["framework"],
    "website": "https://nextjs.org",
    "implies": ["react"],
    "rule": {
      "any": [
        { "kind": "headerPresent", "name": "x-nextjs-cache" },
        { "kind": "headerPresent", "name": "x-nextjs-prerender" },
        { "kind": "htmlRegex", "pattern": "/_next/static/" }
      ]
    }
  },
  {
    "slug": "nuxt",
    "name": "Nuxt",
    "categories": ["framework"],
    "website": "https://nuxt.com",
    "implies": ["vue"],
    "rule": {
      "any": [
        { "kind": "htmlRegex", "pattern": "<div[^>]+id=\"__nuxt\"" },
        { "kind": "htmlRegex", "pattern": "/_nuxt/" }
      ]
    }
  },
  {
    "slug": "sveltekit",
    "name": "SvelteKit",
    "categories": ["framework"],
    "website": "https://svelte.dev",
    "rule": { "kind": "htmlRegex", "pattern": "/_app/immutable/" }
  },
  {
    "slug": "astro",
    "name": "Astro",
    "categories": ["framework"],
    "website": "https://astro.build",
    "rule": {
      "kind": "metaRegex",
      "name": "generator",
      "pattern": "^Astro\\s+v?([\\d.]+)",
      "version": 1
    }
  },
  {
    "slug": "gatsby",
    "name": "Gatsby",
    "categories": ["framework"],
    "website": "https://www.gatsbyjs.com",
    "implies": ["react"],
    "rule": { "kind": "htmlRegex", "pattern": "id=\"___gatsby\"" }
  },
  {
    "slug": "angular",
    "name": "Angular",
    "categories": ["framework"],
    "website": "https://angular.dev",
    "rule": { "kind": "htmlRegex", "pattern": "ng-version=\"([\\d.]+)\"", "version": 1 }
  },
  {
    "slug": "react",
    "name": "React",
    "categories": ["javascript-library"],
    "website": "https://react.dev",
    "rule": {
      "any": [
        { "kind": "htmlRegex", "pattern": "data-reactroot" },
        { "kind": "jsGlobal", "path": "React.version", "pattern": "^(.+)$", "version": 1 }
      ]
    }
  },
  {
    "slug": "vue",
    "name": "Vue.js",
    "categories": ["javascript-library"],
    "website": "https://vuejs.org",
    "rule": {
      "any": [
        { "kind": "htmlRegex", "pattern": "<div[^>]+data-v-app" },
        { "kind": "jsGlobal", "path": "Vue.version", "pattern": "^(.+)$", "version": 1 }
      ]
    }
  },
  {
    "slug": "jquery",
    "name": "jQuery",
    "categories": ["javascript-library"],
    "website": "https://jquery.com",
    "rule": {
      "any": [
        {
          "kind": "scriptSrcRegex",
          "pattern": "jquery[.-]([\\d.]+)(?:\\.min)?\\.js",
          "version": 1
        },
        { "kind": "scriptSrcRegex", "pattern": "jquery(?:\\.min)?\\.js" }
      ]
    }
  },
  {
    "slug": "bootstrap",
    "name": "Bootstrap",
    "categories": ["javascript-library"],
    "website": "https://getbootstrap.com",
    "rule": {
      "any": [
        { "kind": "scriptSrcRegex", "pattern": "bootstrap[@/-]([\\d.]+)", "version": 1 },
        { "kind": "scriptSrcRegex", "pattern": "bootstrap(?:\\.bundle)?(?:\\.min)?\\.js" }
      ]
    }
  },
  {
    "slug": "nginx",
    "name": "Nginx",
    "categories": ["web-server"],
    "website": "https://nginx.org",
    "rule": {
      "kind": "headerRegex",
      "name": "server",
      "pattern": "^nginx(?:/([\\d.]+))?",
      "version": 1
    }
  },
  {
    "slug": "apache",
    "name": "Apache HTTP Server",
    "categories": ["web-server"],
    "website": "https://httpd.apache.org",
    "rule": {
      "kind": "headerRegex",
      "name": "server",
      "pattern": "^Apache(?:/([\\d.]+))?",
      "version": 1
    }
  },
  {
    "slug": "caddy",
    "name": "Caddy",
    "categories": ["web-server"],
    "website": "https://caddyserver.com",
    "rule": { "kind": "headerRegex", "name": "server", "pattern": "^Caddy" }
  },
  {
    "slug": "php",
    "name": "PHP",
    "categories": ["programming-language"],
    "website": "https://www.php.net",
    "rule": {
      "any": [
        {
          "kind": "headerRegex",
          "name": "x-powered-by",
          "pattern": "^PHP/([\\d.]+)",
          "version": 1
        },
        { "kind": "cookiePresent", "name": "phpsessid" }
      ]
    }
  },
  {
    "slug": "aspnet",
    "name": "ASP.NET",
    "categories": ["framework", "programming-language"],
    "website": "https://dotnet.microsoft.com/apps/aspnet",
    "rule": {
      "any": [
        {
          "kind": "headerRegex",
          "name": "x-aspnet-version",
          "pattern": "^([\\d.]+)",
          "version": 1
        },
        { "kind": "headerRegex", "name": "x-powered-by", "pattern": "^ASP\\.NET" }
      ]
    }
  },
  {
    "slug": "cloudflare",
    "name": "Cloudflare",
    "categories": ["cdn", "security"],
    "website": "https://www.cloudflare.com",
    "rule": {
      "any": [
        { "kind": "headerPresent", "name": "cf-ray" },
        { "kind": "headerRegex", "name": "server", "pattern": "^cloudflare$" }
      ]
    }
  },
  {
    "slug": "vercel",
    "name": "Vercel",
    "categories": ["hosting", "cdn"],
    "website": "https://vercel.com",
    "rule": {
      "any": [
        { "kind": "headerPresent", "name": "x-vercel-id" },
        { "kind": "headerRegex", "name": "server", "pattern": "^Vercel$" }
      ]
    }
  },
  {
    "slug": "netlify",
    "name": "Netlify",
    "categories": ["hosting", "cdn"],
    "website": "https://www.netlify.com",
    "rule": {
      "any": [
        { "kind": "headerPresent", "name": "x-nf-request-id" },
        { "kind": "headerRegex", "name": "server", "pattern": "^Netlify" }
      ]
    }
  },
  {
    "slug": "google-tag-manager",
    "name": "Google Tag Manager",
    "categories": ["tag-manager"],
    "website": "https://tagmanager.google.com",
    "rule": {
      "any": [
        { "kind": "scriptSrcRegex", "pattern": "googletagmanager\\.com/gtm\\.js" },
        { "kind": "htmlRegex", "pattern": "googletagmanager\\.com/ns\\.html" }
      ]
    }
  },
  {
    "slug": "google-analytics",
    "name": "Google Analytics",
    "categories": ["analytics"],
    "website": "https://marketingplatform.google.com/about/analytics/",
    "rule": {
      "any": [
        { "kind": "scriptSrcRegex", "pattern": "googletagmanager\\.com/gtag/js" },
        { "kind": "scriptSrcRegex", "pattern": "google-analytics\\.com/(?:ga|analytics)\\.js" }
      ]
    }
  },
  {
    "slug": "plausible",
    "name": "Plausible Analytics",
    "categories": ["analytics"],
    "website": "https://plausible.io",
    "rule": { "kind": "scriptSrcRegex", "pattern": "plausible\\.io/js/" }
  },
  {
    "slug": "posthog",
    "name": "PostHog",
    "categories": ["analytics"],
    "website": "https://posthog.com",
    "rule": { "kind": "htmlRegex", "pattern": "posthog\\.com/static/array\\.js" }
  },
  {
    "slug": "hubspot",
    "name": "HubSpot",
    "categories": ["marketing"],
    "website": "https://www.hubspot.com",
    "rule": { "kind": "scriptSrcRegex", "pattern": "js\\.hs-(?:scripts|analytics)\\.com" }
  },
  {
    "slug": "intercom",
    "name": "Intercom",
    "categories": ["live-chat"],
    "website": "https://www.intercom.com",
    "rule": { "kind": "htmlRegex", "pattern": "widget\\.intercom\\.io" }
  },
  {
    "slug": "stripe",
    "name": "Stripe",
    "categories": ["payment"],
    "website": "https://stripe.com",
    "rule": { "kind": "scriptSrcRegex", "pattern": "js\\.stripe\\.com" }
  },
  {
    "slug": "recaptcha",
    "name": "reCAPTCHA",
    "categories": ["security"],
    "website": "https://www.google.com/recaptcha/about/",
    "rule": { "kind": "scriptSrcRegex", "pattern": "(?:google\\.com|gstatic\\.com)/recaptcha" }
  },
  {
    "slug": "google-fonts",
    "name": "Google Fonts",
    "categories": ["font-script"],
    "website": "https://fonts.google.com",
    "rule": { "kind": "htmlRegex", "pattern": "fonts\\.(?:googleapis|gstatic)\\.com" }
  },
  {
    "slug": "sentry",
    "name": "Sentry",
    "categories": ["error-tracking"],
    "website": "https://sentry.io",
    "rule": { "kind": "htmlRegex", "pattern": "browser\\.sentry-cdn\\.com" }
  },
  {
    "slug": "google-search-console",
    "name": "Google Search Console",
    "categories": ["verification"],
    "website": "https://search.google.com/search-console/about",
    "rule": { "kind": "dnsTxtRegex", "pattern": "^google-site-verification=" }
  },
  {
    "slug": "microsoft-365",
    "name": "Microsoft 365",
    "categories": ["verification"],
    "website": "https://www.microsoft.com/microsoft-365",
    "rule": { "kind": "dnsTxtRegex", "pattern": "^MS=ms\\d+" }
  }
]
