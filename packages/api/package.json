{
  "name": "@domainstack/api",
  "version": "0.0.0-beta.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./middleware": "./src/middleware/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --config ../../.oxfmtrc.json",
    "fmt:check": "oxfmt --check --config ../../.oxfmtrc.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@domainstack/analytics": "workspace:*",
    "@domainstack/auth": "workspace:*",
    "@domainstack/billing": "workspace:*",
    "@domainstack/constants": "workspace:*",
    "@domainstack/db": "workspace:*",
    "@domainstack/edge-config": "workspace:*",
    "@domainstack/email": "workspace:*",
    "@domainstack/logger": "workspace:*",
    "@domainstack/redis": "workspace:*",
    "@domainstack/server": "workspace:*",
    "@domainstack/types": "workspace:*",
    "@domainstack/utils": "workspace:*",
    "@trpc/server": "catalog:",
    "@vercel/functions": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@domainstack/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "next": ">=16"
  }
}
