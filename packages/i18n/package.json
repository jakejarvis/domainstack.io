{
  "name": "@domainstack/i18n",
  "version": "0.0.0-beta.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --config ../../.oxfmtrc.json",
    "fmt:check": "oxfmt --check --config ../../.oxfmtrc.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:"
  },
  "devDependencies": {
    "@domainstack/tsconfig": "workspace:*",
    "@lingui/cli": "catalog:",
    "@lingui/conf": "catalog:",
    "@lingui/format-po": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
