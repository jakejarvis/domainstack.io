#: ../../apps/native/src/app/sign-in.tsx
msgid "By continuing you agree to our <0>Terms</0> and <1>Privacy Policy</1>."
msgstr "En continuant, vous acceptez nos <0>Conditions</0> et notre <1>Politique de confidentialité</1>."

#: ../../apps/native/src/app/sign-in.tsx
msgid "Continue with {providerName}"
msgstr "Continuer avec {providerName}"

#: ../../apps/native/src/app/sign-in.tsx
msgid "Continue with Apple"
msgstr "Continuer avec Apple"

#: ../../apps/web/app/layout.tsx
msgid "Domainstack — Domain Intelligence Made Easy"
msgstr "Domainstack — l’intelligence de domaine simplifiée"

#: ../../apps/web/app/layout.tsx
msgid "Instant lookups for WHOIS, DNS, hosting, certificates, SEO and more, plus free domain tracking and change alerts."
msgstr "Recherches instantanées WHOIS, DNS, hébergement, certificats, SEO et plus, avec suivi de domaines et alertes de changement gratuits."

