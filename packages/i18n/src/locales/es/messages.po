#: ../../apps/native/src/app/sign-in.tsx
msgid "By continuing you agree to our <0>Terms</0> and <1>Privacy Policy</1>."
msgstr "Al continuar, aceptas nuestros <0>Términos</0> y nuestra <1>Política de privacidad</1>."

#: ../../apps/native/src/app/sign-in.tsx
msgid "Continue with {providerName}"
msgstr "Continuar con {providerName}"

#: ../../apps/native/src/app/sign-in.tsx
msgid "Continue with Apple"
msgstr "Continuar con Apple"

#: ../../apps/web/app/layout.tsx
msgid "Domainstack — Domain Intelligence Made Easy"
msgstr "Domainstack: inteligencia de dominios sencilla"

#: ../../apps/web/app/layout.tsx
msgid "Instant lookups for WHOIS, DNS, hosting, certificates, SEO and more, plus free domain tracking and change alerts."
msgstr "Consultas instantáneas de WHOIS, DNS, alojamiento, certificados, SEO y más, además de seguimiento de dominios y alertas de cambios gratis."

#: ../../apps/native/src/app/sign-in.tsx
msgid "Loading sign-in options…"
msgstr "Cargando opciones de inicio de sesión…"

#: ../../apps/native/src/app/sign-in.tsx
msgid "No sign-in providers are available right now."
msgstr "No hay proveedores de inicio de sesión disponibles ahora mismo."

#: ../../apps/native/src/app/sign-in.tsx
msgid "Please try again."
msgstr "Inténtalo de nuevo."

#: ../../apps/native/src/app/sign-in.tsx
msgid "Sign in failed"
msgstr "Error al iniciar sesión"

#: ../../apps/native/src/app/sign-in.tsx
msgid "Sign-in didn’t complete"
msgstr "El inicio de sesión no se completó"

#: ../../apps/native/src/app/sign-in.tsx
msgid "Sign-in options are unavailable."
msgstr "Las opciones de inicio de sesión no están disponibles."

#: ../../apps/web/app/layout.tsx
msgid "Skip to content"
msgstr "Saltar al contenido"

#: ../../apps/native/src/app/sign-in.tsx
msgid "Track ownership, expiry, DNS, and certificate changes; get notified before anything breaks."
msgstr "Controla la titularidad, la caducidad, el DNS y los cambios de certificados; recibe avisos antes de que algo falle."

#: ../../apps/native/src/app/sign-in.tsx
msgid "Try again"
msgstr "Reintentar"

#: ../../apps/native/src/app/sign-in.tsx
msgid "Unable to sign in with {provider}. Please try again."
msgstr "No se pudo iniciar sesión con {provider}. Inténtalo de nuevo."
