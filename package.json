{
  "name": "domainstack",
  "version": "0.0.0-beta.1",
  "private": true,
  "homepage": "https://domainstack.io",
  "license": "MIT",
  "author": {
    "name": "Jake Jarvis",
    "email": "jake@jarv.is",
    "url": "https://github.com/jakejarvis"
  },
  "repository": "jakejarvis/domainstack.io",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:prepare": "node scripts/dev.mjs prepare",
    "dev:doctor": "node scripts/dev.mjs doctor",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "db:start": "node scripts/dev.mjs db:start",
    "db:stop": "node scripts/dev.mjs db:stop",
    "db:reset": "node scripts/dev.mjs db:reset",
    "db:generate": "turbo run db:generate --filter=@domainstack/db",
    "db:push": "node scripts/dev.mjs db:push",
    "db:migrate": "node scripts/dev.mjs db:migrate",
    "db:studio": "node scripts/dev.mjs db:studio",
    "clean": "shx rm -rf .turbo \"apps/*/.turbo\" \"apps/*/node_modules\" \"apps/*/*.tsbuildinfo\" apps/web/.next \"packages/*/.turbo\" \"packages/*/node_modules\" \"packages/*/*.tsbuildinfo\" node_modules pnpm-lock.yaml"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "shx": "^0.4.0",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.x"
  },
  "packageManager": "pnpm@11.27.0"
}
